# ONEFLAT eBay Listing Desk - 環境変数サンプル
# 実際の値は .env.local に書き、絶対にコミットしないこと。
# §102: Secret値は NEXT_PUBLIC_ にしないこと(NEXT_PUBLIC_*はブラウザに露出する)。

# --- Supabase (§11) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic Claude API (§11, §4: モデル名はコードへ直接固定しない) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- eBay Developer (§10) ---
# Sandbox / Production を完全に分離する
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=
EBAY_MARKETPLACE_ID=EBAY_US

# --- トークン暗号化(§9: Refresh Tokenを暗号化保存するための鍵) ---
TOKEN_ENCRYPTION_KEY=
